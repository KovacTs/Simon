# Configuración de Simon - Asistente de Voz para Home Assistant
HA_URL=http://localhost:8123
# Obtén tu token en: Home Assistant -> Perfil (tu usuario) -> Pestaña Seguridad -> Tokens de acceso de larga duración
HA_TOKEN=

# Configuración de Voz
LANGUAGE=es-CL
TTS_VOICE=es-CL-CatalinaNeural
# Alternativas de voz:
# es-CL-CatalinaNeural (Femenina, Chile)
# es-CL-LorenzoNeural (Masculina, Chile)
# es-ES-AlvaroNeural (Masculina, España)
