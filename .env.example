# Configuración de Simon - Asistente de Voz para Home Assistant
HA_URL=http://localhost:8123
# Obtén tu token en: Home Assistant -> Perfil (tu usuario) -> Pestaña Seguridad -> Tokens de acceso de larga duración
HA_TOKEN=

# Configuración de Voz (TTS)
LANGUAGE=es-CL
TTS_VOICE=es-CL-LorenzoNeural
TTS_RATE=+12%
TTS_PITCH=+0Hz
# Alternativas de voz más fluidas/naturales:
# es-CL-LorenzoNeural (Masculina, Chile)
# es-CL-CatalinaNeural (Femenina, Chile)
# es-CO-GonzaloNeural (Masculina, muy fluida en español)
# es-MX-JorgeNeural (Masculina, entonación natural)
# en-US-BrianMultilingualNeural (Voz neural V2 multilingüe ultra natural en español)

# --- Fase 1: Wake Word, Chimes, VAD y STT ---
# Modelo openWakeWord (ej. hey_jarvis, alexa, o ruta a archivo .onnx personalizado como models/oye_simon.onnx)
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.5
WAKE_PHRASES=oye simón,oye simon,simón,simon
CHIMES_ENABLED=true
# Modo silencioso: en acciones visuales (encender/apagar/color/brillo de luz) solo suena un beep sin voz ni texto
BRIEF_MODE=true

# Detección de Fin de Frase (Silero VAD) en milisegundos (< 300ms)
VAD_THRESHOLD=0.5
VAD_SILENCE_MS=280

# Motor STT: auto | faster_whisper | google
STT_ENGINE=auto
WHISPER_MODEL=base

# --- Fase 2: Cerebro con IA Generativa (LLM + Tool Calling) ---
# Proveedor LLM: auto | gemini | ollama | local
LLM_PROVIDER=auto

# Opción A: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Opción B: Ollama Local
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Memoria Contextual (últimas N intervenciones)
MEMORY_MAX_TURNS=5

# Clima (Coordenadas por defecto para Open-Meteo si HA no expone entidad weather)
WEATHER_CITY=Santiago
WEATHER_LAT=-33.4489
WEATHER_LON=-70.6693
